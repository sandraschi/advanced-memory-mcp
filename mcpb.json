{
    "name": "advanced-memory-mcp",
    "version": "1.8.1",
    "type": "server",
    "runtime": "python",
    "entry_point": "src/advanced_memory/mcp/server.py",
    "dependencies": [
        "fastmcp[code-mode]>=3.2.0"
    ],
    "build": {
        "include": [
            "src/**/*",
            "README.md",
            "LICENSE",
            "manifest.json"
        ],
        "exclude": [
            "tests/",
            ".git/",
            "__pycache__/",
            "*.pyc",
            ".venv/",
            "dist/",
            "build/",
            "target/",
            "docs/",
            "scripts/"
        ]
    },
    "scripts": {
        "build": "mcpb build",
        "pack": "mcpb pack . dist/advanced-memory-mcp.mcpb",
        "test": "python -m pytest"
    }
}
