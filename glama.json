{
    "$schema":  "https://glama.ai/mcp/schemas/server.json",
    "maintainers":  [
                        "sandraschi"
                    ],
    "name":  "advanced-memory-mcp",
    "description":  "Local-first knowledge graph and notes: FastMCP 3.2 GA, 12 Managed Namespaces (79 tools), SQLite FTS5 + LanceDB RAG, optional extra document roots, webapp.",
    "type":  "mcp_server",
    "status":  "beta",
    "framework":  "FastMCP 3.2",
    "tools":  79,
    "transport":  [
                      "stdio"
                  ],
    "keywords":  [
                     "knowledge-management",
                     "zettelkasten",
                     "knowledge-graph",
                     "mcp-server",
                     "note-taking",
                     "claude-skills",
                     "pkm",
                     "local-first"
                 ],
    "features":  {
                     "knowledge_management":  {
                                                  "enabled":  true,
                                                  "modes":  [
                                                                "managed-namespaces"
                                                            ],
                                                  "note":  "79 tools across 12 namespaces (FastMCP 3.2 GA)"
                                              },
                     "zettelkasten":  {
                                          "enabled":  true
                                      },
                     "knowledge_graph":  {
                                             "enabled":  true
                                         },
                     "claude_skills":  {
                                           "enabled":  true,
                                           "status":  "experimental"
                                       }
                 },
    "fleet":  {
                  "stars":  "★★★★★",
                  "tier":  1
              }
}
