# Advanced Memory MCP configuration
# Copy to .env and customize

# HTTP daemon proxy URL for stdio clients
# ADVANCED_MEMORY_HTTP_PROXY=http://127.0.0.1:10732/mcp

# Extra directories to watch for file changes
# SYNC_WATCH_DIRS=

# Transport mode (stdio, http, sse)
# MCP_TRANSPORT=stdio

# LLM provider for sampling (ollama, lmstudio)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:latest
